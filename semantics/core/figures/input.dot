  "oku" -> "reg" [label="文字／送りに足して変換（R-OK-01）"];
  "okup" -> "sel" [label="文字／送りに足して変換（R-OK-01）"];
  "okup" -> "reg" [label="文字／送りに足して変換（R-OK-01）"];
  "oku" -> "okup" [label="文字／打ちかけに積む（R-OK-02）\n大文字／小文字として打つ（R-OK-06）"];
  "okup" -> "okup" [label="文字／打ちかけに積む（R-OK-02）\n文字／っ を送りに足す（R-OK-03）\n大文字／小文字として打つ（R-OK-06）\n<BS>／打ちかけを 1 文字消す（R-OK-09）"];
