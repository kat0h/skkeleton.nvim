  "oku" -> "oku" [label="文字／送りに足す（R-OK-05）\n大文字／小文字として打つ（R-OK-06）\n;／何も起きない（R-OK-07）\n<BS>／送りを 1 文字消す（R-OK-08）"];
  "okup" -> "oku" [label="大文字／小文字として打つ（R-OK-06）\n;／何も起きない（R-OK-07）\n<BS>／打ちかけを 1 文字消す（R-OK-09）"];
  "oku" -> "pre" [label="<BS>／送りを 1 文字消す（R-OK-08）"];
  "okup" -> "sel" [label="l・q・;・/・L／ん で変換が走る（R-ST-01）", color="#d64545", fontcolor="#d64545"];
  "okup" -> "reg" [label="l・q・;・/・L／ん で変換が走る（R-ST-01）", color="#d64545", fontcolor="#d64545"];
