digraph {
  rankdir=LR; splines=true; nodesep=0.45; ranksep=0.8;
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#2f6feb", fontname="Noto Sans CJK JP", fontsize=11];
  edge [fontname="Noto Sans CJK JP", fontsize=9, color="#3b5bdb", fontcolor="#3b5bdb"];
  "direct" [label="読みなし"];
  "pending" [label="打ちかけ"];
  "pre0" [label="▽（空）"];
  "pre" [label="▽"];
  "prep" [label="▽ 打ちかけ"];
  "oku" [label="▽ 送り"];
  "okup" [label="▽ 送り 打ちかけ"];
  "sel" [label="▼"];
  "reg" [label="辞書登録"];
  "direct" -> "direct" [label="文字／かなを確定（R-IN-01）\n文字／そのまま確定（R-IN-05）\n<Space>・>／文字として打つ（R-IN-06）\n<BS>／host へ BS（R-IN-07）"];
  "pending" -> "direct" [label="文字／かなを確定（R-IN-01）\n<Space>・>／文字として打つ（R-IN-06）\n<BS>／打ちかけを 1 文字消す（R-IN-08）"];
  "direct" -> "pending" [label="文字／打ちかけに積む（R-IN-02）"];
  "pending" -> "pending" [label="文字／打ちかけに積む（R-IN-02）\n文字／っ を確定（R-IN-03）\n<BS>／打ちかけを 1 文字消す（R-IN-08）"];
  "pending" -> "direct" [label="文字／片付けて打ち直す（R-IN-04）", color="#d64545", fontcolor="#d64545"];
  "pending" -> "pending" [label="文字／片付けて打ち直す（R-IN-04）", color="#d64545", fontcolor="#d64545"];
  "direct" -> "pre0" [label="大文字／▽ を開く（R-IN-09）\n;／▽ を開く（R-IN-10）"];
  "direct" -> "prep" [label="大文字／▽ を開く（R-IN-09）"];
  "pending" -> "pre0" [label="大文字／▽ を開く（R-IN-09）\n;／▽ を開く（R-IN-10）"];
  "pending" -> "prep" [label="大文字／▽ を開く（R-IN-09）"];
  "pre0" -> "pre" [label="文字／読みに足す（R-PR-01）\n文字／読みに足す（R-PR-05）\n>／読みに > を足す（R-PR-06）"];
  "pre" -> "pre" [label="文字／読みに足す（R-PR-01）\n文字／読みに足す（R-PR-05）\n<BS>／読みを 1 文字消す（R-PR-08）"];
  "prep" -> "pre" [label="文字／読みに足す（R-PR-01）\n>／読みに > を足す（R-PR-06）\n<BS>／打ちかけを 1 文字消す（R-PR-09）"];
  "pre0" -> "prep" [label="文字／打ちかけに積む（R-PR-02）\n大文字・;／送りは始まらない（R-PR-10）"];
  "pre" -> "prep" [label="文字／打ちかけに積む（R-PR-02）"];
  "prep" -> "prep" [label="文字／打ちかけに積む（R-PR-02）\n文字／っ を読みに足す（R-PR-03）\n<BS>／打ちかけを 1 文字消す（R-PR-09）\n大文字・;／送りは始まらない（R-PR-10）"];
  "prep" -> "pre" [label="文字／片付けて打ち直す（R-PR-04）", color="#d64545", fontcolor="#d64545"];
  "prep" -> "prep" [label="文字／片付けて打ち直す（R-PR-04）", color="#d64545", fontcolor="#d64545"];
  "prep" -> "pre0" [label="文字／片付けて打ち直す（R-PR-04）", color="#d64545", fontcolor="#d64545"];
  "pre0" -> "direct" [label="<BS>／▽ を閉じる（R-PR-07）"];
  "pre" -> "pre0" [label="<BS>／読みを 1 文字消す（R-PR-08）"];
  "prep" -> "pre0" [label="<BS>／打ちかけを 1 文字消す（R-PR-09）\n大文字・;／送りは始まらない（R-PR-10）"];
