  "pre" -> "direct" [label="<C-g>／読みを消す（R-CK-02）\n<C-j>／読みを確定（R-CK-07）\n<CR>／確定（＋改行）（R-CK-10）"];
  "prep" -> "direct" [label="<C-g>／読みを消す（R-CK-02）\n<C-j>／読みを確定（R-CK-07）\n<CR>／確定（＋改行）（R-CK-10）"];
  "oku" -> "direct" [label="<C-g>／読みを消す（R-CK-02）\n<C-j>／読みを確定（R-CK-07）\n<CR>／確定（＋改行）（R-CK-10）"];
  "okup" -> "direct" [label="<C-g>／読みを消す（R-CK-02）\n<C-j>／読みを確定（R-CK-07）\n<CR>／確定（＋改行）（R-CK-10）"];
