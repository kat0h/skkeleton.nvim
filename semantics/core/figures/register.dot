digraph {
  rankdir=LR; splines=true; nodesep=0.45; ranksep=0.8;
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#2f6feb", fontname="Noto Sans CJK JP", fontsize=11];
  edge [fontname="Noto Sans CJK JP", fontsize=9, color="#3b5bdb", fontcolor="#3b5bdb"];
  "direct" [label="読みなし"];
