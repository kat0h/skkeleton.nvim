  "reg" -> "oku" [label="答え：取り消し／▽ に戻る（R-RG-04）"];
  "reg" -> "okup" [label="答え：取り消し／▽ に戻る（R-RG-04）"];
  "reg" -> "sel" [label="答え：取り消し／最後の候補に戻る（R-RG-05）"];
  "reg" -> "list" [label="答え：取り消し／最後の候補に戻る（R-RG-05）"];
  "reg" -> "pre" [label="<C-g>・<Esc>／登録ごと取り消す（R-RG-06）", color="#d64545", fontcolor="#d64545"];
  "reg" -> "oku" [label="<C-g>・<Esc>／登録ごと取り消す（R-RG-06）", color="#d64545", fontcolor="#d64545"];
  "reg" -> "sel" [label="<C-g>・<Esc>／登録ごと取り消す（R-RG-06）", color="#d64545", fontcolor="#d64545"];
  "reg" -> "list" [label="<C-g>・<Esc>／登録ごと取り消す（R-RG-06）", color="#d64545", fontcolor="#d64545"];
