  "reg" -> "reg" [label="どのキーでも／内側の機械が受ける（R-RG-02）"];
  "reg" -> "direct" [label="答え：語／語＋送りを確定（R-RG-03）"];
  "reg" -> "pre" [label="答え：取り消し／▽ に戻る（R-RG-04）"];
